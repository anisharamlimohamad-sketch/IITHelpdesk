@using ITHelpdesk
@using ITHelpdesk.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "MIS Helpdesk Portal";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts & FontAwesome / Bootstrap Icons -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        :root {
            --bg: #f1f5f9;
            --surface: #ffffff;
            --ink: #1e293b;
            --muted: #64748b;
            --line: #e2e8f0;
            --field: #f8fafc;
            --brand: #4f46e5;
            --brand-dark: #4338ca;
            --hero-1: #17124a;
            --hero-2: #3b34a8;
            --shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.04);
            --lift: 0 15px 30px -5px rgba(0, 0, 0, 0.08);
        }

        body {
            background-color: var(--bg);
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            color: var(--ink);
            margin: 0;
            line-height: 1.6;
        }

        /* Navbar Sticky */
        .navbar-custom {
            position: sticky;
            top: 0;
            z-index: 100;
            background: linear-gradient(135deg, var(--hero-1) 0%, var(--hero-2) 100%);
            color: white;
            transition: all 0.3s ease;
        }

        .header-logo-box {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.15);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-admin-login {
            border: 1px solid rgba(255, 255, 255, 0.3);
            background: rgba(255, 255, 255, 0.1);
            color: white;
            border-radius: 50px;
            padding: 8px 22px;
            font-size: 0.9rem;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-admin-login:hover {
            background: rgba(255, 255, 255, 0.25);
            color: white;
        }

        /* Hero Banner */
        .hero-section {
            background: linear-gradient(135deg, var(--hero-1) 0%, var(--hero-2) 100%);
            color: white;
            padding: 60px 0 130px 0;
            border-radius: 0 0 48px 48px;
            margin-bottom: -70px;
        }

        .hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 16px;
            border-radius: 50px;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.2);
            font-size: 0.85rem;
            font-weight: 600;
        }

        .hero-eyebrow span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #4ade80;
            box-shadow: 0 0 0 4px rgba(74, 222, 128, 0.25);
        }

        /* Quick Track Input in Hero */
        .hero-track-box {
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 50px;
            padding: 6px;
            max-width: 480px;
        }

        .hero-track-box input {
            background: transparent;
            border: none;
            color: white;
            padding-left: 18px;
        }

        .hero-track-box input::placeholder {
            color: rgba(255, 255, 255, 0.7);
        }

        .hero-track-box input:focus {
            outline: none;
            box-shadow: none;
            background: transparent;
            color: white;
        }

        /* Mock Ticket Card */
        .mock-ticket {
            background: white;
            color: var(--ink);
            border-radius: 24px;
            padding: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            transform: rotate(1.5deg);
        }

        /* Selection Cards */
        .option-card {
            background: var(--surface);
            border-radius: 24px;
            box-shadow: var(--shadow);
            border: 1px solid var(--line);
            cursor: pointer;
            transition: all 0.25s ease-in-out;
        }

        .option-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--lift);
        }

        .icon-box {
            width: 50px;
            height: 50px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .icon-red { 
            background-color: #ffe4e6; 
            color: #f43f5e; 
        }

        .icon-blue { 
            background-color: #e0e7ff; 
            color: #4f46e5; 
        }

        .icon-green { 
            background-color: #d1fae5; 
            color: #10b981; 
        }

        .icon-purple { 
            background-color: #f3e8ff; 
            color: #9333ea; 
        }

        .btn-custom-red { 
            background-color: #f43f5e; 
            color: #ffffff; 
            border-radius: 50px; 
            border: none; 
            padding: 10px 16px; 
            font-weight: 600; 
        }

        .btn-custom-blue { 
            background-color: #4f46e5; 
            color: #ffffff; 
            border-radius: 50px; 
            border: none; 
            padding: 10px 16px; 
            font-weight: 600; 
        }

        .btn-custom-green { 
            background-color: #0d9488; 
            color: #ffffff; 
            border-radius: 50px; 
            border: none; 
            padding: 10px 16px; 
            font-weight: 600; 
        }

        .btn-custom-purple { 
            background-color: #9333ea; 
            color: #ffffff; 
            border-radius: 50px; 
            border: none; 
            padding: 10px 16px; 
            font-weight: 600; 
        }


        /* Form Container */
        .form-container {
            display: none;
            background: var(--surface);
            border-radius: 28px;
            padding: 45px 50px;
            box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.05);
            margin-top: 10px;
            border: 1px solid var(--line);
        }

        .active-form {
            display: block;
            animation: fadeIn 0.35s ease-in-out;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .input-group-custom {
            position: relative;
        }

        .input-group-custom .input-icon {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
            font-size: 1.05rem;
            z-index: 5;
            pointer-events: none;
        }

        .form-control-custom, .form-select-custom {
            background-color: var(--field);
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 13px 18px 13px 48px;
            font-size: 0.95rem;
            color: var(--ink);
            transition: all 0.2s ease;
        }

        .form-control-custom:focus, .form-select-custom:focus {
            background-color: var(--surface);
            border-color: var(--brand);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        }

        .textarea-custom {
            background-color: var(--field);
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 18px;
            font-size: 0.95rem;
            color: var(--ink);
            transition: all 0.2s ease;
            width: 100%;
        }

        .btn-submit-purple {
            background: var(--brand);
            color: white;
            border-radius: 50px;
            padding: 12px 30px;
            font-weight: 600;
            border: none;
            box-shadow: 0 8px 18px -4px rgba(79, 70, 229, 0.4);
            transition: all 0.2s ease;
        }

        .btn-submit-purple:hover {
            background: var(--brand-dark);
            color: white;
            transform: translateY(-1px);
        }

        .btn-back-pill {
            border: 1px solid var(--line);
            background: var(--surface);
            color: var(--muted);
            border-radius: 50px;
            padding: 8px 20px;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-back-pill:hover {
            background: var(--bg);
            color: var(--ink);
        }
/* Styling untuk Knowledge Base Layout Dua Kolum */
.kb-pill {
    background-color: #ffffff;
    border: 1px solid #e6e8f0;
    border-radius: 12px;
    padding: 0.85rem 1rem;
    color: #1e293b;
    font-weight: 500;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: all 0.2s ease;
}

.kb-pill:hover {
    border-color: #4f46e5;
    box-shadow: 0 4px 12px rgba(79, 70, 229, 0.08);
    color: #4f46e5;
}

.kb-icon {
    color: #4f46e5;
    font-size: 1.1rem;
}

/* Accordion Sebelah Kanan */
.kb-accordion .accordion-item {
    background-color: #ffffff;
    border: 1px solid #e6e8f0 !important;
    border-radius: 12px !important;
    margin-bottom: 0.75rem;
    overflow: hidden;
}

.kb-accordion .accordion-button {
    background-color: #ffffff;
    color: #0f172a;
    font-weight: 600;
    box-shadow: none !important;
}

.kb-accordion .accordion-button:not(.collapsed) {
    color: #4f46e5;
    background-color: #f8fafc;
}

        /* Stats Section */
        .stat-card {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 20px;
            padding: 24px;
            box-shadow: var(--shadow);
        }

        /* How It Works Steps */
        .step-box {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 20px;
            padding: 26px 20px;
            position: relative;
        }

        .step-badge {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--brand), var(--brand-dark));
            color: white;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 14px;
        }

        /* Priority Banner */
        .priority-banner {
            background: linear-gradient(120deg, #fff1f1 0%, #ffffff 70%);
            border: 1px solid rgba(244, 63, 94, 0.3);
            border-left: 8px solid #f43f5e;
            border-radius: 28px;
            padding: 40px;
        }

        footer {
            background: linear-gradient(135deg, var(--hero-1) 0%, var(--hero-2) 100%);
            color: white;
            border-radius: 40px 40px 0 0;
            padding: 50px 0 30px 0;
            margin-top: 80px;
        }
    </style>
</head>
<body>

        <!-- ========================================== -->
        <!------------------ NAV BAR --------------------->
        <!-- ========================================== -->

     <nav class="navbar-custom py-3">
      <div class="container d-flex justify-content-between align-items-center">
        <a href="#top" class="d-flex align-items-center gap-3 text-decoration-none text-white" onclick="goBackToDashboard()">
         <div class="header-logo-box">
         <i class="fa-solid fa-headset fa-lg text-white"></i>
         </div>
         <h4 class="fw-bold mb-0">MIS Helpdesk</h4>
        </a>
         <div class="d-flex align-items-center gap-3">
          <a asp-controller="AdminLogin" asp-action="Login" class="btn-admin-login">
          <i class="fa-solid fa-lock me-2"></i>Admin login
          </a>
        </div>
      </div>
    </nav>


        <!-- ========================================== -->
        <!-------------- BANNER SECTION ------------------>
        <!-- ========================================== -->

     <div class="hero-section" id="top">
     <div class="container">
     <div class="row align-items-center g-5">
     <div class="col-lg-7">
     <div class="hero-eyebrow mb-3">
     <span></span> MIS Team is Online
     </div>
     <h1 class="fw-extrabold display-4 text-white mb-3" style="font-weight: 800;">
      Fast IT support for <span style="background: linear-gradient(90deg,#c4bfff,#8ff0e1); -webkit-background-clip: text; color: transparent;">every employee</span>
     </h1>
     <p class="lead text-white-50 mb-4" style="max-width: 500px;">
      Report a problem, request new equipment and follow your ticket status in real time — all in one place.
     </p>
     
     <div class="d-flex flex-wrap gap-3 mb-4">
     <button class="btn btn-light rounded-pill px-4 py-3 fw-bold text-primary shadow" onclick="showForm('incident-form')">
       <i class="fa-solid fa-wrench me-2"></i> MIS Support
     </button>
     <button class="btn btn-outline-light rounded-pill px-4 py-3 fw-bold" onclick="showForm('track-form')">
       <i class="fa-solid fa-magnifying-glass me-2"></i> Track My Ticket
     </button>
     </div>

     <!-- Quick Track Bar -->
     <form asp-controller="TrackStatus" asp-action="TrackStatus" method="get" class="hero-track-box d-flex align-items-center">
      <input type="text" name="searchQuery" class="form-control" placeholder="Enter Employee ID or Asset Name..." required />
      <button type="submit" class="btn btn-light rounded-pill px-4 py-2 fw-bold text-dark ms-2">Check</button>
     </form>
     </div>

     <!-- Mock Status Card -->
     <div class="col-lg-5 d-none d-lg-block">
     <div class="mock-ticket">
     <div class="d-flex justify-content-between align-items-center mb-3">
     <div>
     <small class="text-muted d-block">Reference Ticket</small>
     <span class="fw-bold fs-5 text-primary">20261101-01</span>
     </div>
     <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-2 rounded-pill">In Progress</span>
     </div>
     <div class="row g-2 mb-3 small">
     <div class="col-6"><span class="text-muted">Asset:</span> <strong>NGKPC000</strong></div>
     <div class="col-6"><span class="text-muted">Dept:</span> <strong>Finance</strong></div>
     </div>
                        <hr />
     <div class="d-flex align-items-center gap-2 small text-muted">
    <i class="fa-solid fa-comment-dots text-primary"></i>
   <span>Technician is diagnosing hardware memory issue.</span>
   </div>
    </div>
   </div>
   </div>
   </div>
   </div>


        <!-- ========================================== -->
        <!-------------- MAIN CONTAINER ------------------>
        <!-- ========================================== -->

    <div class="container pb-5" style="position: relative; z-index: 10;">

        <!-- Success Notifications -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm mt-3" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["MisSuccess"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm mt-3" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i> @TempData["MisSuccess"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- ========================================== -->
        <!---------- DASHBOARD SELECTION CARDS ----------->
        <!-- ========================================== -->

        <div id="selection-dashboard" class="row g-4 justify-content-center pt-4">
            
            <!-- OPTION 1 : MIS SUPPORT -->
            <div class="col-lg-3 col-md-6">
                <div class="option-card h-100 d-flex flex-column justify-content-between p-4" onclick="showForm('incident-form')">
                    <div>
                        <div class="icon-box icon-red mb-3">
                            <i class="fa-solid fa-wrench"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-2">MIS Support</h4>
                        <p class="text-muted small mb-4">Report hardware failures, internet network issues or IT software problems.</p>
                    </div>
                    <button class="btn btn-custom-red w-100 d-flex justify-content-between align-items-center px-3 py-2">
                        <span>Request Ticket</span>
                        <i class="fa-solid fa-chevron-right small"></i>
                    </button>
                </div>
            </div>

            <!-- OPTION 2 : MIS REQUEST -->
            <div class="col-lg-3 col-md-6">
                <div class="option-card h-100 d-flex flex-column justify-content-between p-4">
                    <div>
                        <div class="icon-box icon-blue mb-3">
                            <i class="fa-solid fa-laptop"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-2">MIS Request</h4>
                        <p class="text-muted small mb-4">Request new laptops, hardware equipment or equipment upgrades.</p>
                    </div>
                    <button class="btn btn-custom-blue w-100 d-flex justify-content-between align-items-center px-3 py-2">
                        <span>Future Development</span>
                        <i class="fa-solid fa-chevron-right small"></i>
                    </button>
                </div>
            </div>

            <!-- OPTION 3 : TRACK STATUS -->
            <div class="col-lg-3 col-md-6">
                <div class="option-card h-100 d-flex flex-column justify-content-between p-4" onclick="showForm('track-form')">
                    <div>
                        <div class="icon-box icon-green mb-3">
                            <i class="fa-solid fa-magnifying-glass-chart"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-2">Track Status</h4>
                        <p class="text-muted small mb-4">Check the real-time progress of your tickets or requests.</p>
                    </div>
                    <button class="btn btn-custom-green w-100 d-flex justify-content-between align-items-center px-3 py-2">
                        <span>Check status</span>
                        <i class="fa-solid fa-chevron-right small"></i>
                    </button>
                </div>
            </div>

            <!-- OPTION 4 : KNOWLEDGE BASE -->
            <div class="col-lg-3 col-md-6">
                <div class="option-card h-100 d-flex flex-column justify-content-between p-4">
                    <div>
                        <div class="icon-box icon-purple mb-3">
                            <i class="fa-solid fa-book-open"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-2">Knowledge Base</h4>
                        <p class="text-muted small mb-4">Reference guides and manuals for common IT issues.</p>
                    </div>
                    <button class="btn btn-custom-purple w-100 d-flex justify-content-between align-items-center px-3 py-2">
                        <span>Future Development</span>
                        <i class="fa-solid fa-chevron-right small"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!------------- MIS SUPPORT FORM ----------------->
        <!-- ========================================== -->

        <div id="incident-form" class="form-container">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-box icon-red mb-0" style="width: 52px; height: 52px;">
                        <i class="fa-solid fa-wrench"></i>
                    </div>
                    <h2 class="fw-bold text-dark mb-0">MIS Support Ticket</h2>
                </div>
                <button type="button" class="btn btn-back-pill" onclick="goBackToDashboard()">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back
                </button>
            </div>

            <p class="text-muted mb-4 pb-2" style="margin-left: 68px;">
                Fill the details and MIS team will review your request.
            </p>

            <form asp-controller="UserPortal" asp-action="SubmitIncident" method="post">
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark mb-2">Employee ID</label>
                        <div class="input-group-custom">
                            <i class="fa-solid fa-id-card-clip input-icon"></i>
                            <input type="text" name="EmployeeId" class="form-control form-control-custom" placeholder="E.g., MW12345" required />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark mb-2">Asset Name</label>
                        <div class="input-group-custom">
                            <i class="fa-solid fa-desktop input-icon"></i>
                            <input type="text" name="AssetName" class="form-control form-control-custom" placeholder="E.g., NGKPC000" required />
                        </div>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark mb-2">Department</label>
                        <div class="input-group-custom">
                            <i class="fa-solid fa-building input-icon"></i>
                            <input type="text" name="Department" class="form-control form-control-custom" placeholder="E.g., Finance / HR" required />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark mb-2">Section</label>
                        <div class="input-group-custom">
                            <i class="fa-solid fa-sitemap input-icon"></i>
                            <input type="text" name="Section" class="form-control form-control-custom" placeholder="E.g., Accounts" required />
                        </div>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark mb-2">Area</label>
                        <div class="input-group-custom">
                            <i class="fa-solid fa-location-dot input-icon"></i>
                            <input type="text" name="Area" class="form-control form-control-custom" placeholder="E.g., Level 2, Office B" required />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark mb-2">Issue Category *</label>
                        <div class="input-group-custom">
                            <i class="fa-solid fa-layer-group input-icon"></i>
                            <select name="Category" id="issueCategorySelect" class="form-select form-select-custom" onchange="checkUrgentCategory()" required>
                                <option value="" disabled selected>Select a category</option>
                                <optgroup label="Standard">
                                    <option value="Laptop">Laptop</option>
                                    <option value="Internet / Network">Internet / Network</option>
                                    <option value="Printer">Printer</option>
                                    <option value="Software / Access">Software / Access</option>
                                </optgroup>
                                <optgroup label="Priority (Urgent)">
                                    <option value="SATO Case">SATO Case (Urgent)</option>
                                    <option value="VIP Case">VIP Case (Urgent)</option>
                                </optgroup>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- WARNING ALERT FOR URGENT CASES -->
                <div id="urgentAlertBox" class="alert alert-danger d-none align-items-center gap-3 mb-4 rounded-3 border-danger bg-danger-subtle p-3" role="alert">
                    <i class="fa-solid fa-triangle-exclamation fa-xl text-danger"></i>
                    <div>
                        <strong class="text-danger d-block" id="urgentAlertTitle">Urgent Priority Incident</strong>
                        <span class="small text-danger-emphasis" id="urgentAlertDesc">
                            This ticket will be flagged with top priority on the MIS Admin Dashboard for immediate response.
                        </span>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-dark mb-2">Problem Description</label>
                    <textarea name="ProblemDescription" rows="4" class="form-control textarea-custom" placeholder="Describe the issue in detail..." required></textarea>
                </div>

                <div class="d-flex align-items-center gap-4 pt-2">
                    <button type="submit" class="btn btn-submit-purple d-flex align-items-center gap-2">
                        <span>Submit ticket</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </form>
        </div>

        <!-- ========================================== -->
        <!------------ MIS REQUEST FORM ------------------>
        <!-- ========================================== -->

        <div id="mis-form" class="form-container">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-box icon-blue mb-0" style="width: 52px; height: 52px;">
                        <i class="fa-solid fa-laptop"></i>
                    </div>
                    <h2 class="fw-bold text-dark mb-0">MIS Request Ticket</h2>
                </div>
                <button type="button" class="btn btn-back-pill" onclick="goBackToDashboard()">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back
                </button>
            </div>

            <p class="text-muted mb-4 pb-2" style="margin-left: 68px;">
                Fill the details for the equipments.
            </p>

            <form asp-controller="UserPortal" asp-action="SubmitMis" method="post">
                <div class="mb-4">
                    <label class="form-label fw-bold text-dark mb-2">Requester Employee ID</label>
                    <div class="input-group-custom">
                        <i class="fa-solid fa-id-card input-icon"></i>
                        <input type="text" name="RequesterEmployeeId" class="form-control form-control-custom" placeholder="E.g., MW12345" required />
                    </div>
                </div>
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark mb-2">Department</label>
                        <div class="input-group-custom">
                            <i class="fa-solid fa-building input-icon"></i>
                            <input type="text" name="Department" class="form-control form-control-custom" placeholder="E.g., Engineering" required />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark mb-2">Request Type</label>
                        <div class="input-group-custom">
                            <i class="fa-solid fa-laptop input-icon"></i>
                            <select name="RequestType" class="form-select form-select-custom">
                                <option>New Laptop</option>
                                <option>Hardware Upgrade</option>
                                <option>Peripherals (Mouse, Keyboard, Monitor)</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark mb-2">New Hire Name (if applicable)</label>
                        <div class="input-group-custom">
                            <i class="fa-solid fa-user-plus input-icon"></i>
                            <input type="text" name="NewHireName" class="form-control form-control-custom" placeholder="New employee name" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark mb-2">Needed Date</label>
                        <div class="input-group-custom">
                            <i class="fa-solid fa-calendar-days input-icon"></i>
                            <input type="date" name="NeededDate" class="form-control form-control-custom" required />
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-4 pt-2">
                    <button type="submit" class="btn btn-submit-purple d-flex align-items-center gap-2">
                        <span>Submit MIS request</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </form>
        </div>

        <!-- ========================================== -->
        <!------------- TRACK STATUS FORM ---------------->
        <!-- ========================================== -->

        <div id="track-form" class="form-container">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-box icon-green mb-0" style="width: 52px; height: 52px;">
                        <i class="fa-solid fa-magnifying-glass-chart"></i>
                    </div>
                    <h2 class="fw-bold text-dark mb-0">Track Request & Status</h2>
                </div>
                <button type="button" class="btn btn-back-pill" onclick="goBackToDashboard()">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back
                </button>
            </div>

            <p class="text-muted mb-4 pb-2" style="margin-left: 68px;">
                Check request ticket or report directly.
            </p>

            <form asp-controller="TrackStatus" asp-action="TrackStatus" method="get" class="mb-4">
                <div class="mb-4">
                    <label class="form-label fw-bold text-dark mb-2">Search Query</label>
                    <div class="input-group-custom">
                        <i class="fa-solid fa-magnifying-glass input-icon"></i>
                        <input type="text" name="searchQuery" class="form-control form-control-custom" placeholder="Enter Employee ID or Asset Name (E.g., NGKPC000)..." required />
                    </div>
                </div>

                <button type="submit" class="btn btn-submit-purple d-flex align-items-center gap-2">
                    <span>Search status</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </form>

            <div class="text-muted small">
                <i class="fa-solid fa-circle-info me-1"></i> Enter search details to view real-time status updates and notes from the IT Admin team.
            </div>
        </div>

        <!-- ========================================== -->
        <!------------ KNOWLEDGE BASE PAGE --------------->
        <!-- ========================================== -->

        <div id="knowledge-form" class="form-container">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-box icon-purple mb-0" style="width: 52px; height: 52px;">
                        <i class="fa-solid fa-book-open"></i>
                    </div>
                    <h2 class="fw-bold text-dark mb-0">Knowledge Base</h2>
                </div>
                <button type="button" class="btn btn-back-pill" onclick="goBackToDashboard()">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back
                </button>
            </div>

            <p class="text-muted mb-4 pb-2" style="margin-left: 68px;">
                Reference guides and manuals for common IT issues.
            </p>

            <div class="accordion" id="kbAccordion">
                <div class="accordion-item border rounded-3 mb-3 overflow-hidden">
                    <h2 class="accordion-header" id="headingOne">
                        <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                            <i class="fa-solid fa-wifi text-primary me-2"></i> Wi-Fi or internet is not working
                        </button>
                    </h2>
                    <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#kbAccordion">
                        <div class="accordion-body text-muted">
                            <ol class="mb-0 ps-3">
                                <li>Turn Wi-Fi off and on, then reconnect.</li>
                                <li>Restart your laptop.</li>
                                <li>If colleagues are affected too, report it as an Internet / Network issue.</li>
                            </ol>
                        </div>
                    </div>
                </div>
                <div class="accordion-item border rounded-3 mb-3 overflow-hidden">
                    <h2 class="accordion-header" id="headingTwo">
                        <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                            <i class="fa-solid fa-print text-success me-2"></i> Printer is not printing
                        </button>
                    </h2>
                    <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#kbAccordion">
                        <div class="accordion-body text-muted">
                            <ol class="mb-0 ps-3">
                                <li>Check paper, toner, and clear any jams.</li>
                                <li>Make sure the correct network printer is selected.</li>
                                <li>Clear the print queue and try again.</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- LANDING PAGE EXTRA CONTENT -->
        <div id="landing-extra" class="mt-5 pt-4">

            <!-- STATS SECTION -->
            <div class="row g-4 mb-5 justify-content-center">
                <div class="col-md-3 col-6">
                    <div class="stat-card text-center">
                        <h2 class="fw-bold text-primary mb-1">1,248</h2>
                        <span class="text-muted small">Resolved Tickets</span>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-card text-center">
                        <h2 class="fw-bold text-primary mb-1">15 min</h2>
                        <span class="text-muted small">Avg Response Time</span>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-card text-center">
                        <h2 class="fw-bold text-primary mb-1">96%</h2>
                        <span class="text-muted small">SLA Resolution</span>
                    </div>
                </div>
            </div>

            <!-- HOW IT WORKS -->
            <div class="text-center mb-4">
                <span class="text-primary fw-bold text-uppercase small">How It Works</span>
                <h2 class="fw-bold text-dark mt-1">From report to resolved in 4 steps</h2>
            </div>

            <div class="row g-4 mb-5">
                <div class="col-md-3 col-sm-6">
                    <div class="step-box h-100">
                        <div class="step-badge">1</div>
                        <h5 class="fw-bold text-dark">Submit</h5>
                        <p class="text-muted small mb-0">Fill in a short form with your asset details and issue description.</p>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="step-box h-100">
                        <div class="step-badge">2</div>
                        <h5 class="fw-bold text-dark">Assigned</h5>
                        <p class="text-muted small mb-0">MIS team reviews your request and assigns a field technician.</p>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="step-box h-100">
                        <div class="step-badge">3</div>
                        <h5 class="fw-bold text-dark">In Progress</h5>
                        <p class="text-muted small mb-0">We diagnose and resolve the issue. Track live updates online.</p>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="step-box h-100">
                        <div class="step-badge">4</div>
                        <h5 class="fw-bold text-dark">Resolved</h5>
                        <p class="text-muted small mb-0">Issue fixed! Rate our service or track ticket history anytime.</p>
                    </div>
                </div>
            </div>

            <!-- ========================================== -->
            <!--------- KNOWLEDGE BASE SECTION ------------->
            <!-- ========================================== -->

            <div class="mb-5 py-4 border-top">
                <div class="row align-items-start g-5">
                    
                    <div class="col-lg-5">
                        <span class="text-primary fw-bold text-uppercase small">Knowledge Base</span>
                        <h2 class="fw-bold text-dark mt-1 mb-3">Try these before raising a ticket</h2>
                        <p class="text-muted mb-4">Many common issues can be solved in a minute.</p>

                        <!-- Knowledge Categories -->
                        <div class="row g-3 mb-4">
                            <div class="col-6">
                                <a href="#landingCollapseOne" data-bs-toggle="collapse" class="kb-pill d-flex align-items-center gap-2 text-decoration-none">
                                    <i class="fa-solid fa-wifi kb-icon"></i>
                                    <span>Wi-Fi</span>
                                </a>
                            </div>
                            <div class="col-6">
                                <a href="#landingCollapseTwo" data-bs-toggle="collapse" class="kb-pill d-flex align-items-center gap-2 text-decoration-none">
                                    <i class="fa-solid fa-print kb-icon"></i>
                                    <span>Printer</span>
                                </a>
                            </div>
                            <div class="col-6">
                                <a href="#landingCollapseThree" data-bs-toggle="collapse" class="kb-pill d-flex align-items-center gap-2 text-decoration-none">
                                    <i class="fa-solid fa-key kb-icon"></i>
                                    <span>Password</span>
                                </a>
                            </div>
                            <div class="col-6">
                                <a href="#landingCollapseFour" data-bs-toggle="collapse" class="kb-pill d-flex align-items-center gap-2 text-decoration-none">
                                    <i class="fa-solid fa-battery-half kb-icon"></i>
                                    <span>Laptop battery</span>
                                </a>
                            </div>
                        </div>

                        <!-- Support Ticket -->
                        <button type="button" class="btn btn-submit-purple d-inline-flex align-items-center gap-2" onclick="showForm('incident-form')">
                            <i class="fa-solid fa-wrench"></i>
                            <span>Still need help? Raise ticket</span>
                        </button>
                    </div>

                    <!-- Accordion FAQ -->
                    <div class="col-lg-7">
                        <div class="accordion kb-accordion" id="landingKbAccordion">
                            
                            <!-- WiFi -->
                            <div class="accordion-item border rounded-3 mb-3 overflow-hidden shadow-sm">
                                <h2 class="accordion-header" id="landingHeadingOne">
                                    <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#landingCollapseOne" aria-expanded="true" aria-controls="landingCollapseOne">
                                        My Wi-Fi or internet is not working
                                    </button>
                                </h2>
                                <div id="landingCollapseOne" class="accordion-collapse collapse show" aria-labelledby="landingHeadingOne" data-bs-parent="#landingKbAccordion">
                                    <div class="accordion-body text-muted">
                                        Turn Wi-Fi off and on, then reconnect. If other colleagues are affected too, report it as Internet / Network.
                                    </div>
                                </div>
                            </div>

                            <!-- Printer -->
                            <div class="accordion-item border rounded-3 mb-3 overflow-hidden shadow-sm">
                                <h2 class="accordion-header" id="landingHeadingTwo">
                                    <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#landingCollapseTwo" aria-expanded="false" aria-controls="landingCollapseTwo">
                                        The printer is not printing
                                    </button>
                                </h2>
                                <div id="landingCollapseTwo" class="accordion-collapse collapse" aria-labelledby="landingHeadingTwo" data-bs-parent="#landingKbAccordion">
                                    <div class="accordion-body text-muted">
                                        Check if the printer has paper, toner, and is connected to the office network. Try restarting the print spooler or selecting the correct network printer.
                                    </div>
                                </div>
                            </div>

                            <!-- Password Reset -->
                            <div class="accordion-item border rounded-3 mb-3 overflow-hidden shadow-sm">
                                <h2 class="accordion-header" id="landingHeadingThree">
                                    <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#landingCollapseThree" aria-expanded="false" aria-controls="landingCollapseThree">
                                        I forgot my password or I am locked out
                                    </button>
                                </h2>
                                <div id="landingCollapseThree" class="accordion-collapse collapse" aria-labelledby="landingHeadingThree" data-bs-parent="#landingKbAccordion">
                                    <div class="accordion-body text-muted">
                                        Use the self-service password reset link on the login screen. If your account remains locked after 15 minutes, submit an Account Access ticket.
                                    </div>
                                </div>
                            </div>

                            <!-- Response Time -->
                            <div class="accordion-item border rounded-3 mb-3 overflow-hidden shadow-sm">
                                <h2 class="accordion-header" id="landingHeadingFour">
                                    <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#landingCollapseFour" aria-expanded="false" aria-controls="landingCollapseFour">
                                        How long does a request usually take?
                                    </button>
                                </h2>
                                <div id="landingCollapseFour" class="accordion-collapse collapse" aria-labelledby="landingHeadingFour" data-bs-parent="#landingKbAccordion">
                                    <div class="accordion-body text-muted">
                                        Standard incidents receive an initial response within 15 minutes. Hardware or software provisioning requests typically take 1 to 2 business days depending on approval.
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        
        <!-- ========================================== -->
        <!-------------- ANNOUNCEMENT BAR ---------------->
        <!-- ========================================== -->

        <div class="announcement-banner my-4">
            <div class="card border-0 rounded-4 shadow-sm overflow-hidden" style="background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);">
                <div class="card-body p-4 text-white">
                    <div class="d-flex align-items-start gap-3">
                        <div class="bg-white text-primary p-3 rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 shadow-sm" style="width: 50px; height: 50px;">
                        <i class="fa-solid fa-bullhorn fs-4"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="badge bg-white text-primary rounded-pill px-3 py-1 fw-bold" style="font-size: 0.75rem;">
                                    <i class="fa-solid fa-circle-info me-1"></i> MIS Announcement
                                </span>
                                @if (ViewBag.AnnouncementDate != null)
                                {
                                    <small class="text-white-50"><i class="fa-regular fa-clock me-1"></i>@ViewBag.AnnouncementDate</small>
                                }
                            </div>
                            <h5 class="fw-bold mb-1 text-white">@ViewBag.AnnouncementTitle</h5>
                            <p class="mb-0 text-white-50" style="font-size: 0.95rem; line-height: 1.5;">
                                @ViewBag.AnnouncementContent
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

            <!-- ========================================== -->
            <!-------------- CONTACT SECTION --------------->
            <!-- ========================================== -->

            <div class="mt-5 pt-4">
                <div class="mb-4 text-center">
                    <span class="text-primary fw-bold text-uppercase small">Contact</span>
                    <h2 class="fw-bold text-dark mt-1">Need to reach us directly?</h2>
                </div>

                <div class="row g-4 mb-5 justify-content-center">
                    <!-- Card 1: Support Hours -->
                    <div class="col-lg-3 col-md-6 col-12">
                        <div class="stat-card h-100 p-4 border rounded-4 bg-white shadow-sm">
                            <div class="text-primary mb-3 fs-4">
                                <i class="fa-regular fa-clock"></i>
                            </div>
                            <span class="text-muted small d-block mb-1">Support hours</span>
                            <h5 class="fw-bold text-dark mb-0">Mon – Fri, 8:30 AM – 5:30 PM</h5>
                        </div>
                    </div>

                    <!-- Card 2: Extension -->
                    <div class="col-lg-3 col-md-6 col-12">
                        <div class="stat-card h-100 p-4 border rounded-4 bg-white shadow-sm">
                            <div class="text-primary mb-3 fs-4">
                                <i class="fa-solid fa-phone"></i>
                            </div>
                            <span class="text-muted small d-block mb-1">Extension</span>
                            <h5 class="fw-bold text-dark mb-0">Ext. 147</h5>
                        </div>
                    </div>

                    <!-- Card 3: Location -->
                    <div class="col-lg-3 col-md-6 col-12">
                        <div class="stat-card h-100 p-4 border rounded-4 bg-white shadow-sm">
                            <div class="text-primary mb-3 fs-4">
                                <i class="fa-solid fa-location-dot"></i>
                            </div>
                            <span class="text-muted small d-block mb-1">Location</span>
                            <h5 class="fw-bold text-dark mb-0">MIS Room, Level 2</h5>
                        </div>
                    </div>
                </div>
            </div>
      </div>
</div>          


    <!-- FOOTER -->
    <footer>
        <div class="container text-center text-md-start">
            <div class="row g-4 justify-content-between">
                <div class="col-md-5">
                    <h4 class="fw-bold text-white mb-2">MIS Helpdesk Portal</h4>
                    <p class="text-white-50 small">Internal IT Support System for fast hardware, software, and network troubleshooting.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="d-flex flex-wrap justify-content-md-end gap-3 small">
                        <a href="#top" class="text-white-50 text-decoration-none" onclick="showForm('incident-form')">MIS Support</a>
                        <a href="#top" class="text-white-50 text-decoration-none" onclick="showForm('mis-form')">MIS Request</a>
                        <a href="#top" class="text-white-50 text-decoration-none" onclick="showForm('track-form')">Track Status</a>
                        <a asp-controller="AdminLogin" asp-action="Login" class="text-white-50 text-decoration-none">Admin Login</a>
                    </div>
                </div>
            </div>
            <hr class="border-secondary my-4" />
            <div class="d-flex justify-content-between align-items-center text-white-50 small flex-wrap gap-2">
                <span>&copy; @DateTime.Now.Year MIS Helpdesk. Internal Use Only.</span>
                <span>Penang, Malaysia</span>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function checkUrgentCategory() {
            const select = document.getElementById("issueCategorySelect");
            const alertBox = document.getElementById("urgentAlertBox");
            const alertTitle = document.getElementById("urgentAlertTitle");
            const alertDesc = document.getElementById("urgentAlertDesc");

            if (select.value === "SATO Case") {
                alertBox.classList.remove("d-none");
                alertBox.classList.add("d-flex");
                alertTitle.innerHTML = "🚨 SATO Case - High Priority Incident";
                alertDesc.innerHTML = "This SATO report will be flagged with a red alert badge on the MIS Admin Dashboard for immediate technical dispatch.";
            } 
            else if (select.value === "VIP Case") {
                alertBox.classList.remove("d-none");
                alertBox.classList.add("d-flex");
                alertTitle.innerHTML = "👑 VIP Case - Executive Priority Incident";
                alertDesc.innerHTML = "This VIP report will be highlighted as top executive request on the MIS Admin Dashboard for immediate support.";
            } 
            else {
                alertBox.classList.add("d-none");
                alertBox.classList.remove("d-flex");
            }
        }

        function showForm(formId) {
            document.getElementById('selection-dashboard').style.display = 'none';
            document.getElementById('landing-extra').style.display = 'none';
            document.querySelectorAll('.form-container').forEach(el => {
                el.classList.remove('active-form');
            });
            document.getElementById(formId).classList.add('active-form');
            window.scrollTo({ top: 120, behavior: 'smooth' });
        }

        function goBackToDashboard() {
            document.querySelectorAll('.form-container').forEach(el => {
                el.classList.remove('active-form');
            });
            document.getElementById('selection-dashboard').style.display = 'flex';
            document.getElementById('landing-extra').style.display = 'block';
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>
</body>
</html>